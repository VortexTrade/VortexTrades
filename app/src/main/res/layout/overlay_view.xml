<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:padding="14dp">

    <!-- Drag handle + close row -->
    <RelativeLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:background="@drawable/handle_background" />

        <TextView
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="@string/close"
            android:textColor="@color/overlay_dim"
            android:textSize="16sp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="@string/overlay_title"
            android:textColor="@color/overlay_text"
            android:textStyle="bold"
            android:textSize="14sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="240dp"
        android:minHeight="60dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/adviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_idle"
            android:textColor="@color/overlay_text"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/calculateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculate_now"
        android:textColor="#FF102010"
        android:textStyle="bold"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/button_background" />

</LinearLayout>
